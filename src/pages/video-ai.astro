---
import Base from '../layouts/Base.astro';
import { CAPABILITIES, STUDIO, PACKAGES, PRICING_AS_OF, FPS } from '../data/phosor.ts';
---
<Base
  title="Video AI — CFLabs"
  description="Every model, capability and published price: text to video, image to video, lip-sync, motion transfer, multi-reference generation, LoRA training, e-commerce imaging and speech synthesis."
  section="video"
>
  <section class="wrap hero">
    <p class="kicker">Video AI</p>
    <h1>Every model,<br />every price.</h1>
    <p class="lede">
      One account, one API key, one rate per second that does not change when you scale.
      Everything below runs today on Phosor.
    </p>
    <div class="btnrow">
      <a class="btn btn--primary" href="https://phosor.ai/" rel="noopener">Open Phosor <span class="arr">↗</span></a>
      <a class="btn btn--ghost" href="#pricing">Go to the price table</a>
    </div>
  </section>

  <section class="wrap section" id="pricing">
    <h2>Generation</h2>
    <p class="body" style="margin-top:18px">
      Video is billed per frame at {FPS} frames a second; the per-second figures here are
      the published per-frame price multiplied out.
    </p>

    <div class="tablewrap" style="margin-top:34px">
      <table>
        <thead>
          <tr>
            <th>Capability</th>
            <th>Model</th>
            <th>Resolution</th>
            <th class="n">Price</th>
            <th class="n">Unit</th>
          </tr>
        </thead>
        <tbody>
          {CAPABILITIES.map((r) => (
            <tr>
              <td>
                <strong>{r.capability}</strong>
                <br /><span class="muted" style="font-size:14px">{r.detail}</span>
              </td>
              <td>{r.model}</td>
              <td class="n">{r.res}</td>
              <td class="n">{r.price}</td>
              <td class="n muted">{r.unit}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="tnote" style="margin-top:16px">
      Read from the platform's public pricing endpoint on {PRICING_AS_OF}. Generation with
      a LoRA applied is 1.2x the base rate.
    </p>
  </section>

  <section class="wrap section rule">
    <h2>Image Studio</h2>
    <p class="body" style="margin-top:18px">
      Commerce imaging, priced per job rather than per second.
    </p>
    <div class="tablewrap" style="margin-top:30px">
      <table>
        <thead><tr><th>Job</th><th>What it does</th><th class="n">Price</th></tr></thead>
        <tbody>
          {STUDIO.map((s) => (
            <tr>
              <td><strong>{s.job}</strong></td>
              <td class="muted">{s.detail}</td>
              <td class="n">{s.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap section rule">
    <h2>Credit</h2>
    <div class="figs" style="margin-top:34px">
      {PACKAGES.map((p) => (
        <div class="fig">
          <b>{p.price}</b>
          <span>{p.name} · {p.credits} credits</span>
          <span style="text-transform:none;letter-spacing:0;font-size:13px">up to {p.concurrency} concurrent jobs</span>
        </div>
      ))}
    </div>
    <p class="tnote" style="margin-top:26px">
      10 credits to the US dollar. Auto top-up and invoices are available on the account.
    </p>
  </section>

  <section class="wrap section rule">
    <h2>Integration</h2>
    <div class="things" style="margin-top:34px">
      <article class="thing">
        <h3>Submit and poll</h3>
        <p>Submit a job, poll its status, fetch the result. History, per-job detail and downloads are all addressable.</p>
      </article>
      <article class="thing">
        <h3>Keys and credit</h3>
        <p>Issue API keys per environment. Balance, per-job charges and invoices are readable from the account.</p>
      </article>
      <article class="thing">
        <h3>Your own assets</h3>
        <p>Upload datasets for LoRA training, import LoRA weights from a URL, and keep generated output in platform storage.</p>
      </article>
    </div>
    <p style="margin-top:34px">
      <a class="btn btn--primary" href="https://phosor.ai/" rel="noopener">Create an account <span class="arr">↗</span></a>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(56px, 8vw, 112px) clamp(32px, 4vw, 56px);
    display: flex; flex-direction: column; gap: 26px; align-items: flex-start;
  }
  .hero h1 { font-size: clamp(38px, 6.4vw, 66px); max-width: 14ch; }
</style>
