---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).sort(
    (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
  );
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, prev: notes[i + 1] ?? null, next: notes[i - 1] ?? null },
  }));
}

const { note, prev, next } = Astro.props;
const { Content } = await render(note);

const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });
---
<Base
  title={`${note.data.title} — CFLabs`}
  description={note.data.blurb}
  section="research"
  ogType="article"
>
  <article class="wrap art">
    <a class="crumb" href="/research/#video">← Research</a>

    <header class="art__head">
      <h1>{note.data.title}</h1>
      <p class="lede">{note.data.blurb}</p>
      <p class="art__meta">
        <time datetime={note.data.date}>{fmt(note.data.date)}</time>
        <span>{note.data.topic}</span>
        {note.data.updated && <span>updated {fmt(note.data.updated)}</span>}
      </p>
    </header>

    <div class="prose"><Content /></div>

    <aside class="falsify">
      <p class="kicker">How to prove this wrong</p>
      <p>{note.data.falsifier}</p>
    </aside>

    <footer class="art__foot">
      <nav class="art__nav">
        {prev && (
          <a href={`/research/video/${prev.id}/`}>
            <span class="tag">Older</span>
            <span class="art__navtitle">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a href={`/research/video/${next.id}/`} class="art__next">
            <span class="tag">Newer</span>
            <span class="art__navtitle">{next.data.title}</span>
          </a>
        )}
      </nav>
    </footer>
  </article>
</Base>

<style>
  .art { padding-block: 40px 72px; display: flex; flex-direction: column; gap: 34px; }
  .crumb { font-family: var(--f-mono); font-size: 13px; color: var(--muted); }
  .crumb:hover { color: var(--accent-ink); text-decoration: none; }

  .art__head { display: flex; flex-direction: column; gap: 20px; }
  .art__head h1 { font-size: clamp(32px, 4.8vw, 52px); max-width: 20ch; }
  .art__meta {
    display: flex; flex-wrap: wrap; gap: 6px 20px;
    font-family: var(--f-mono); font-size: 12.5px; color: var(--muted);
  }

  .falsify {
    max-width: 68ch;
    border-left: 2px solid var(--accent);
    padding: 4px 0 4px 22px;
    display: flex; flex-direction: column; gap: 9px;
  }
  .falsify p:last-child { color: var(--ink-2); font-size: 16.5px; }

  .art__foot { border-top: 1px solid var(--line); padding-top: 26px; }
  .art__nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; }
  .art__nav a { display: flex; flex-direction: column; gap: 7px; color: var(--ink); }
  .art__nav a:hover { text-decoration: none; }
  .art__nav a:hover .art__navtitle { color: var(--accent-ink); }
  .art__navtitle { font-family: var(--f-display); font-weight: 600; font-size: 18px; letter-spacing: -0.015em; line-height: 1.25; }
  .art__next { text-align: right; align-items: flex-end; }
</style>
