---
import Base from '../../layouts/Base.astro';
import zk from '../../data/zk-research.json';

export function getStaticPaths() {
  return zk.map((a, i) => ({
    params: { slug: a.slug },
    props: { article: a, prev: zk[i + 1] ?? null, next: zk[i - 1] ?? null },
  }));
}

const { article, prev, next } = Astro.props;

const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });
---
<Base
  title={`${article.title} — CFLabs`}
  description={article.blurb}
  section="research"
  ogType="article"
>
  <article class="wrap art">
    <a class="crumb" href="/research/#zk">← Research</a>

    <header class="art__head">
      <h1>{article.title}</h1>
      <p class="lede">{article.blurb}</p>
      <p class="art__meta">
        <time datetime={article.date}>{fmt(article.date)}</time>
        <span>{article.topic}</span>
        <span>{article.words.toLocaleString('en-GB')} words</span>
      </p>
    </header>

    <div class="prose" set:html={article.html} />

    <footer class="art__foot">
      <p class="tnote">
        Originally published on <a href={article.medium} rel="noopener">Medium ↗</a>.
      </p>
      <nav class="art__nav">
        {prev && (
          <a href={`/research/${prev.slug}/`}>
            <span class="tag">Older</span>
            <span class="art__navtitle">{prev.title}</span>
          </a>
        )}
        {next && (
          <a href={`/research/${next.slug}/`} class="art__next">
            <span class="tag">Newer</span>
            <span class="art__navtitle">{next.title}</span>
          </a>
        )}
      </nav>
    </footer>
  </article>
</Base>

<style>
  .art { padding-block: 40px 72px; display: flex; flex-direction: column; gap: 34px; }
  .crumb { font-family: var(--f-mono); font-size: 13px; color: var(--muted); }
  .crumb:hover { color: var(--accent-ink); text-decoration: none; }

  .art__head { display: flex; flex-direction: column; gap: 20px; max-width: 24ch; }
  .art__head { max-width: none; }
  .art__head h1 { font-size: clamp(32px, 4.8vw, 52px); max-width: 20ch; }
  .art__meta {
    display: flex; flex-wrap: wrap; gap: 6px 20px;
    font-family: var(--f-mono); font-size: 12.5px; color: var(--muted);
  }

  .art__foot { border-top: 1px solid var(--line); padding-top: 26px; display: flex; flex-direction: column; gap: 30px; }
  .art__nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; }
  .art__nav a { display: flex; flex-direction: column; gap: 7px; color: var(--ink); }
  .art__nav a:hover { text-decoration: none; }
  .art__nav a:hover .art__navtitle { color: var(--accent-ink); }
  .art__navtitle { font-family: var(--f-display); font-weight: 600; font-size: 18px; letter-spacing: -0.015em; line-height: 1.25; }
  .art__next { text-align: right; align-items: flex-end; }
</style>
