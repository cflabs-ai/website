---
import Base from '../../layouts/Base.astro';
import zk from '../../data/zk-research.json';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
);

const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
  });
---
<Base
  title="Research — CFLabs"
  description="Published research in two tracks: video generation post-training and the model landscape, and zero-knowledge proof systems from RISC0 and SP1 to Binius, Jolt and Aleo."
  section="research"
>
  <section class="wrap hero">
    <p class="kicker">Research</p>
    <h1>What we find out,<br />written down.</h1>
    <p class="lede">
      Two tracks: video generation, and the proof systems underneath our acceleration work.
    </p>
  </section>

  <section class="wrap section" id="video">
    <div class="cta">
      <h2>Video generation</h2>
      <a class="tlink" href="https://github.com/aoraki-labs-ai/Awesome-Video-AI-Research" rel="noopener">
        Source index on GitHub <span class="arr">↗</span>
      </a>
    </div>
    <ol class="rows" style="margin-top:34px">
      {notes.map((n) => (
        <li class="row">
          <div class="row__meta">
            <time datetime={n.data.date}>{fmt(n.data.date)}</time>
            <span class="tag">{n.data.topic}</span>
          </div>
          <div class="row__body">
            <h3><a href={`/research/video/${n.id}/`}>{n.data.title}</a></h3>
            <p>{n.data.blurb}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section rule" id="zk">
    <h2>Proof systems</h2>
    <p class="body" style="margin-top:18px">
      Written between October 2024 and September 2025 while building ZKVM accelerators.
      Full texts, with their figures.
    </p>
    <ol class="rows" style="margin-top:34px">
      {zk.map((a) => (
        <li class="row">
          <div class="row__meta">
            <time datetime={a.date}>{fmt(a.date)}</time>
            <span class="tag">{a.topic}</span>
          </div>
          <div class="row__body">
            <h3><a href={`/research/${a.slug}/`}>{a.title}</a></h3>
            <p>{a.blurb}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(56px, 8vw, 112px) clamp(32px, 4vw, 56px);
    display: flex; flex-direction: column; gap: 26px; align-items: flex-start;
  }
  .hero h1 { font-size: clamp(38px, 6.4vw, 66px); max-width: 15ch; }
</style>
