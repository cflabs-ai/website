---
import Base from '../layouts/Base.astro';
import zk from '../data/zk-research.json';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
);

const latest = [
  ...notes.map((n) => ({
    title: n.data.title, href: `/research/video/${n.id}/`,
    date: n.data.date, topic: n.data.topic, blurb: n.data.blurb,
  })),
  ...zk.map((a) => ({
    title: a.title, href: `/research/${a.slug}/`,
    date: a.date, topic: a.topic, blurb: a.blurb,
  })),
].sort((a, b) => +new Date(b.date) - +new Date(a.date)).slice(0, 3);

const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
  });
---
<Base
  title="CFLabs — video generation, by the second"
  description="CFLabs runs open-weight video models on its own infrastructure and sells them by the second, through Phosor. It also designs ASIC and software acceleration for zero-knowledge proving."
  section="home"
>
  <!-- hero -->
  <section class="wrap hero">
    <h1>Video generation,<br />by the second.</h1>
    <p class="lede">
      We run open-weight video models on our own infrastructure and meter them by the
      second — text to video, image to video, lip-sync, motion transfer, and your own
      LoRAs. The platform is <strong>Phosor</strong>.
    </p>
    <div class="btnrow">
      <a class="btn btn--primary" href="https://phosor.ai/" rel="noopener">Open Phosor <span class="arr">↗</span></a>
      <a class="btn btn--ghost" href="/video-ai/">Models and pricing</a>
    </div>
  </section>

  <!-- figures -->
  <section class="wrap section--tight">
    <div class="figs">
      <div class="fig"><b>$0.010</b><span>per second, 720p</span></div>
      <div class="fig"><b>1080p</b><span>resolution ceiling</span></div>
      <div class="fig"><b>11</b><span>model capabilities</span></div>
      <div class="fig"><b>$0.003</b><span>per LoRA train step</span></div>
    </div>
  </section>

  <!-- what you can make -->
  <section class="wrap section">
    <h2>What you can make</h2>
    <div class="things" style="margin-top:34px">
      <article class="thing">
        <h3>A film from a prompt or a still</h3>
        <p>
          Text to video and image to video on Wan 2.2, in a full and a distilled "turbo"
          variant. Iterate on turbo at a third of the price, then run the locked shot
          through the full model at up to 1080p.
        </p>
      </article>
      <article class="thing">
        <h3>A character who speaks and moves</h3>
        <p>
          Lip-sync driven by an audio track, motion transferred from a reference
          performance, and speech synthesis if you do not have a voice yet.
        </p>
      </article>
      <article class="thing">
        <h3>A product catalogue from one photograph</h3>
        <p>
          Scene variations, mannequin to model, pose changes, background replacement and
          in-image text localisation — at 2K or 4K.
        </p>
      </article>
      <article class="thing">
        <h3>A model that knows your character</h3>
        <p>
          Train a LoRA on your own dataset, or import <code>.safetensors</code> you
          already own. Several can apply to a single request.
        </p>
      </article>
    </div>
    <p style="margin-top:34px">
      <a class="tlink" href="/video-ai/">Every model, capability and price <span class="arr">→</span></a>
    </p>
  </section>

  <!-- zk line -->
  <section class="wrap section rule">
    <h2>We also make proofs cheap</h2>
    <p class="lede" style="margin-top:20px">
      Custom ASIC and software co-design for zero-knowledge proving — more than
      <strong>20x the throughput of a GPU prover</strong> on the same workload, delivered
      into production hardware with Intchains.
    </p>
    <p style="margin-top:26px">
      <a class="tlink" href="/zk-acceleration/">How the hardware works <span class="arr">→</span></a>
    </p>
  </section>

  <!-- research -->
  <section class="wrap section rule">
    <div class="cta">
      <h2>Research</h2>
      <a class="tlink" href="/research/">All {zk.length + notes.length} pieces <span class="arr">→</span></a>
    </div>
    <ol class="rows" style="margin-top:34px">
      {latest.map((a) => (
        <li class="row">
          <div class="row__meta">
            <time datetime={a.date}>{fmt(a.date)}</time>
            <span class="tag">{a.topic}</span>
          </div>
          <div class="row__body">
            <h3><a href={a.href}>{a.title}</a></h3>
            <p>{a.blurb}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- partners -->
  <section class="wrap section--tight">
    <p class="kicker">Built with</p>
    <div class="logos" style="margin-top:24px">
      <img src="/img/logo_intchains.png" alt="Intchains Group" width="248" height="53" loading="lazy" />
      <img src="/img/logo_risczero.png" alt="RISC Zero" width="83" height="61" loading="lazy" />
      <img src="/img/logo_succinct.png" alt="Succinct" width="364" height="98" loading="lazy" />
    </div>
  </section>

  <!-- closing -->
  <section class="wrap section rule">
    <div class="cta">
      <h2>Generate something.</h2>
      <a class="btn btn--primary" href="https://phosor.ai/" rel="noopener">Open Phosor <span class="arr">↗</span></a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(64px, 11vw, 150px) clamp(40px, 6vw, 72px);
    display: flex; flex-direction: column; gap: 30px;
    align-items: flex-start;
  }
  .hero h1 { max-width: 15ch; }
  .hero .lede { margin-top: -4px; }
</style>
