---
import Base from '../layouts/Base.astro';
---
<Base
  title="Not found — CFLabs"
  description="That page is not on this site. Links to the video platform, the ZK acceleration work and the research archive."
  section="home"
>
  <section class="wrap hero">
    <p class="kicker">404</p>
    <h1>Not here.</h1>
    <p class="lede">
      That address is not on this site. It may have moved when cflabs.ai was rebuilt in
      September 2026 — everything is still here, under new addresses.
    </p>
    <div class="btnrow">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn btn--ghost" href="/video-ai/">Video AI</a>
      <a class="btn btn--ghost" href="/zk-acceleration/">ZK Acceleration</a>
      <a class="btn btn--ghost" href="/research/">Research</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(64px, 10vw, 140px) clamp(64px, 10vw, 140px);
    display: flex; flex-direction: column; gap: 26px; align-items: flex-start;
  }
</style>
