---
/**
 * A strip of film: perforation rails top and bottom, with one cell per frame.
 *
 * Every cell is drawn identically on purpose. An earlier version filled some
 * cells and left others empty, which read as a half-finished progress bar
 * rather than as film.
 */
export interface Props {
  /** how many frames to draw — always something real, e.g. 16 for one second */
  count?: number;
  thin?: boolean;
  violet?: boolean;
  label?: string;
  class?: string;
}
const { count = 16, thin = false, violet = false, label, class: cls = '' } = Astro.props;
const cells = Array.from({ length: count }, (_, i) => i);
---
<div class={`fs-wrap ${cls}`}>
  <div
    class={`film${thin ? ' film--thin' : ''}${violet ? ' film--violet' : ''}`}
    role="img"
    aria-label={label ?? `${count} frames of film`}
  >
    <span class="film__rail" aria-hidden="true"></span>
    <span class="film__frames">
      {cells.map(() => <i></i>)}
    </span>
    <span class="film__rail" aria-hidden="true"></span>
  </div>
  {label && <p class="fs-label">{label}</p>}
</div>

<style>
  .fs-wrap { display: flex; flex-direction: column; gap: 9px; }

  .film {
    /* --edge is the frame outline: mint-ink is bright on dark and dark on light,
       so the strip keeps its contrast in both themes. --accent is the soft fill. */
    --accent: var(--mint);
    --edge: var(--mint-ink);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 4px 5px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--surface);
  }
  .film--violet { --accent: var(--violet); --edge: var(--violet); }

  /* sprocket holes — what makes this read as film rather than a meter */
  .film__rail {
    display: block;
    height: 4px;
    border-radius: 1px;
    background-image: repeating-linear-gradient(
      to right,
      var(--line-2) 0 5px,
      transparent 5px 12px
    );
  }

  .film__frames { display: flex; gap: 3px; }
  .film__frames i {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    height: 24px;
    border-radius: 1px;
    border: 1px solid color-mix(in srgb, var(--edge) 62%, transparent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .film--thin .film__frames i { height: 12px; }
  .film--thin .film__rail { height: 3px; }

  .fs-label {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: .05em;
    color: var(--muted);
    margin: 0;
  }
</style>
